<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.rampmaster.poo_calculadora.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <VBox prefHeight="200.0" prefWidth="100.0">
            <children>
               <Label fx:id="firstNumberLabel" text="Numero 1" />
               <TextField fx:id="firstNumber" />
            </children>
         </VBox>
         <VBox prefHeight="200.0" prefWidth="100.0">
            <children>
               <Label fx:id="secondNumberLabel" text="Numero 2" />
               <TextField fx:id="secondNumber" />
            </children>
         </VBox>
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Button fx:id="sumarButton" mnemonicParsing="false" onAction="#onSumar" text="Sumar" />
         <Button fx:id="restarButton" mnemonicParsing="false" onAction="#onRestar" text="Restar" />
         <Button fx:id="multiplicarButton" mnemonicParsing="false" onAction="#onMultiplicar" text="Multiplicar" />
         <Button fx:id="dividirButton" mnemonicParsing="false" onAction="#onDivision" text="Dividir" />
         <Button fx:id="moduloButton" mnemonicParsing="false" onAction="#onModulo" text="Modulo" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Resultado:" />
         <Label fx:id="resultText" />
      </children>
   </HBox>
</VBox>
